<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen Holguín | Senior IT Project Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-canvas: #E6E2D8;
            --container-bg: #FFFFFF;
            --dark-main: #1C1917;
            --gray-text: #78716C;
            --light-bg: #F5F5F4;
            --border-color: #E7E5E4;
            --radius-outer: 36px;
            --radius-inner: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--dark-main);
            padding: 24px;
            line-height: 1.5;
        }

        /* Contenedor principal flotante idéntico al mockup */
        .mockup-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--container-bg);
            border-radius: var(--radius-outer);
            box-shadow: 0 25px 50px rgba(0,0,0,0.06);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.04);
        }

        /* 1. Header Superior Minimalista */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 45px;
            border-bottom: 1px solid var(--border-color);
        }

        .header-logo-pill {
            background: var(--light-bg);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-center-links {
            display: flex;
            gap: 35px;
            list-style: none;
        }

        .header-center-links a {
            text-decoration: none;
            color: var(--gray-text);
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .header-center-links a:hover {
            color: var(--dark-main);
        }

        .header-cta-btn {
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 9px 24px;
            border-radius: 24px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* 2. Primer Bloque Hero (Título izq + Foto der con marco suave) */
        .hero-block-one {
            padding: 60px 45px;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 50px;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .hero-block-one h1 {
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 18px;
            color: var(--dark-main);
        }

        .hero-block-one p {
            font-size: 1rem;
            color: var(--gray-text);
            margin-bottom: 25px;
        }

        .hero-action-btn {
            display: inline-block;
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 14px 32px;
            border-radius: 28px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .hero-image-frame {
            width: 100%;
            height: 300px;
            border-radius: var(--radius-inner);
            overflow: hidden;
            background-color: var(--light-bg);
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

        .hero-image-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

        /* 3. Segundo Bloque: Gran Banner Curvo Oscuro (Idéntico al mockup) */
        .dark-curved-section {
            padding: 45px;
        }

        .dark-curved-card {
            background: var(--dark-main);
            border-radius: var(--radius-outer);
            padding: 60px;
            color: var(--container-bg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .dark-curved-card h2 {
            font-size: 2.4rem;
            font-weight: 600;
            max-width: 600px;
            line-height: 1.2;
        }

        .banner-white-btn {
            background: var(--container-bg);
            color: var(--dark-main);
            padding: 14px 28px;
            border-radius: 28px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        /* 4. Tercer Bloque: Fila de Tarjetas Mini de Perfiles (Mockup style) */
        .mini-profiles-row {
            padding: 0 45px 45px 45px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .mini-profile-card {
            background: var(--light-bg);
            padding: 20px 24px;
            border-radius: var(--radius-inner);
            display: flex;
            align-items: center;
            gap: 16px;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .mini-avatar-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--border-color);
            overflow: hidden;
            flex-shrink: 0;
        }

        .mini-avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .mini-profile-info h4 {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .mini-profile-info p {
            font-size: 0.8rem;
            color: var(--gray-text);
        }

        /* 5. Secciones de Contenido (Proyectos, Herramientas, etc.) */
        .content-block-box {
            padding: 45px 45px 65px 45px;
            border-top: 1px solid var(--border-color);
        }

        .section-heading-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 35px;
        }

        .section-heading-row h2 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--dark-main);
        }

        .section-heading-row p {
            color: var(--gray-text);
            font-size: 0.92rem;
        }

        /* Grid de Proyectos Estilo Tarjetas Limpias */
        .projects-grid-modern {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .project-item-card {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 35px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .project-item-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .project-tag-badge {
            background: var(--container-bg);
            padding: 5px 14px;
            border-radius: 14px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .project-item-card h3 {
            font-size: 1.25rem;
            margin-bottom: 10px;
            color: var(--dark-main);
        }

        .project-item-card p {
            color: var(--gray-text);
            font-size: 0.92rem;
            margin-bottom: 20px;
        }

        /* Herramientas Grid */
        .tools-flex-layout {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }

        .tool-pill-badge {
            background: var(--light-bg);
            padding: 12px 22px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 0.92rem;
            border: 1px solid rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Educación Grid */
        .education-grid-layout {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .education-item-card {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 28px;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .education-tag-small {
            display: inline-block;
            background: var(--container-bg);
            padding: 4px 12px;
            border-radius: 10px;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 12px;
            color: var(--dark-main);
        }

        .education-item-card h3 {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--dark-main);
            margin-bottom: 8px;
        }

        .education-item-card p {
            font-size: 0.85rem;
            color: var(--gray-text);
        }

        /* 6. Footer Oscuro Inferior */
        footer {
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 60px 45px 35px 45px;
            border-top-left-radius: 32px;
            border-top-right-radius: 32px;
        }

        .footer-grid-layout {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 45px;
        }

        .footer-column-item h4 {
            font-size: 1.05rem;
            margin-bottom: 14px;
            color: var(--container-bg);
        }

        .footer-column-item p {
            color: #A8A29E;
            font-size: 0.88rem;
            margin-bottom: 10px;
        }

        .footer-links-list {
            list-style: none;
        }

        .footer-links-list li {
            margin-bottom: 10px;
        }

        .footer-links-list a {
            color: #A8A29E;
            text-decoration: none;
            font-size: 0.88rem;
        }

        .footer-social-row {
            display: flex;
            gap: 12px;
            margin-top: 18px;
        }

        .footer-social-row a {
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.08);
            color: var(--container-bg);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .footer-bottom-bar {
            padding-top: 25px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #78716C;
            font-size: 0.82rem;
        }

        @media (max-width: 768px) {
            .hero-block-one, .projects-grid-modern, .education-grid-layout, .footer-grid-layout, .mini-profiles-row {
                grid-template-columns: 1fr;
            }
            .dark-curved-card {
                flex-direction: column;
                gap: 25px;
                text-align: center;
                padding: 40px 20px;
            }
            .header-center-links {
                display: none;
            }
            .mockup-wrapper {
                border-radius: 20px;
            }
            body {
                padding: 10px;
            }
        }
    </style>
</head>
