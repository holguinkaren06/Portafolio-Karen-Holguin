<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen Holguín | Senior IT Project Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-body: #F4F1EA; /* Tono arena/taupe cálido de fondo */
            --card-bg: #FFFFFF;
            --dark-primary: #1C1917;
            --accent-taupe: #78716C;
            --light-taupe: #E7E5E4;
            --tag-bg: #F5F5F4;
            --border-radius: 32px;
            --card-radius: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-body);
            color: var(--dark-primary);
            line-height: 1.6;
            padding: 20px;
        }

        /* Contenedor general estilo mockup flotante */
        .page-wrapper {
            max-width: 1280px;
            margin: 0 auto;
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: 0 20px 50px rgba(0,0,0,0.06);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.04);
        }

        /* Navbar Superior */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 50px;
            border-bottom: 1px solid var(--light-taupe);
        }

        .logo {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--dark-primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--accent-taupe);
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--dark-primary);
        }

        .btn-nav-contact {
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 10px 24px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: opacity 0.3s;
        }

        .btn-nav-contact:hover {
            opacity: 0.85;
        }

        /* Hero Section Superior (Inspirado en la referencia) */
        .hero-section {
            padding: 60px 50px;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 40px;
            align-items: center;
        }

        .hero-content h1 {
            font-size: 3.2rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 20px;
            color: var(--dark-primary);
        }

        .hero-content h1 span {
            color: var(--accent-taupe);
        }

        .hero-content p {
            font-size: 1.05rem;
            color: var(--accent-taupe);
            margin-bottom: 30px;
        }

        .btn-hero {
            display: inline-block;
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 14px 32px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            transition: transform 0.3s ease;
        }

        .btn-hero:hover {
            transform: translateY(-2px);
        }

        /* Contenedor de la Fotografía Real */
        .hero-image-box {
            width: 100%;
            height: 380px;
            border-radius: var(--card-radius);
            overflow: hidden;
            background-color: var(--light-taupe);
            position: relative;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        }

        .hero-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

        /* Tarjeta Destacada de Frase (Bloque Central estilo mockup) */
        .featured-banner {
            margin: 0 50px 60px 50px;
            background: linear-gradient(135deg, #292524 0%, #1C1917 100%);
            border-radius: var(--card-radius);
            padding: 60px;
            color: var(--card-bg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .featured-banner h2 {
            font-size: 2.4rem;
            font-weight: 600;
            max-width: 600px;
            line-height: 1.2;
        }

        .featured-banner .badge-box {
            background: rgba(255,255,255,0.1);
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 0.9rem;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255,255,255,0.15);
        }

        /* Secciones Contenedoras */
        .content-section {
            padding: 0 50px 80px 50px;
        }

        .section-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            border-bottom: 1px solid var(--light-taupe);
            padding-bottom: 20px;
        }

        .section-header-custom h2 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--dark-primary);
        }

        .section-header-custom p {
            color: var(--accent-taupe);
            font-size: 0.95rem;
        }

        /* Grid de Proyectos */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 25px;
        }

        .project-card {
            background-color: var(--tag-bg);
            border-radius: var(--card-radius);
            padding: 35px;
            border: 1px solid rgba(0,0,0,0.03);
            transition: transform 0.3s ease;
        }

        .project-card:hover {
            transform: translateY(-4px);
        }

        .project-tag {
            display: inline-block;
            background: var(--card-bg);
            color: var(--dark-primary);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .project-card h3 {
            font-size: 1.25rem;
            margin-bottom: 10px;
            color: var(--dark-primary);
        }

        .project-card p {
            color: var(--accent-taupe);
            font-size: 0.92rem;
        }

        /* Grid de Herramientas */
        .tools-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .tool-pill {
            background-color: var(--tag-bg);
            padding: 12px 24px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 0.95rem;
            border: 1px solid rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Grid de Educación */
        .education-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
        }

        .edu-card {
            background-color: var(--tag-bg);
            border-radius: var(--card-radius);
            padding: 30px;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .edu-tag {
            display: inline-block;
            background: var(--card-bg);
            color: var(--dark-primary);
            padding: 4px 12px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        .edu-card h3 {
            font-size: 1.1rem;
            color: var(--dark-primary);
            margin-bottom: 6px;
        }

        .edu-card p {
            color: var(--accent-taupe);
            font-size: 0.88rem;
        }

        /* Footer Oscuro Estilo Mockup */
        footer {
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 60px 50px 30px 50px;
            border-top-left-radius: 30px;
            border-top-right-radius: 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: var(--card-bg);
        }

        .footer-col p {
            color: #A8A29E;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: #A8A29E;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--card-bg);
        }

        .social-row {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .social-row a {
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.08);
            color: var(--card-bg);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background 0.3s;
        }

        .social-row a:hover {
            background: var(--accent-taupe);
        }

        .footer-bottom-bar {
            padding-top: 25px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #78716C;
            font-size: 0.85rem;
        }

        @media (max-width: 768px) {
            .hero-section {
                grid-template-columns: 1fr;
                padding: 30px 20px;
            }
            .featured-banner {
                flex-direction: column;
                gap: 20px;
                padding: 30px 20px;
                margin: 0 20px 40px 20px;
                text-align: center;
            }
            .footer-grid {
                grid-template-columns: 1fr;
            }
            nav, .content-section {
                padding-left: 20px;
                padding-right: 20px;
            }
        }
    </style>
</head>
