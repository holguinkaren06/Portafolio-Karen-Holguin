<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen Holguín | Senior IT Project Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-canvas: #EAE6DF; /* Color crema/arena exacto de tu fondo */
            --card-white: #FFFFFF;
            --dark-main: #1C1917; /* Gris oscuro profundo */
            --gray-text: #78716C; /* Tono taupe/gris suave */
            --light-bg: #F5F5F4; /* Fondo claro para tarjetas internas */
            --border-color: #E7E5E4; /* Líneas divisorias suaves */
            --radius-outer: 36px;
            --radius-inner: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--dark-main);
            padding: 20px;
            line-height: 1.5;
        }

        /* Contenedor principal blanco flotante sobre el fondo crema */
        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--card-white);
            border-radius: var(--radius-outer);
            box-shadow: 0 25px 50px rgba(0,0,0,0.06);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.04);
        }

        /* 1. Navbar Superior */
        .top-navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 45px;
            border-bottom: 1px solid var(--border-color);
        }

        .brand-logo-pill {
            background: var(--light-bg);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--dark-main);
        }

        .nav-links-center {
            display: flex;
            gap: 35px;
            list-style: none;
        }

        .nav-links-center a {
            text-decoration: none;
            color: var(--gray-text);
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .nav-links-center a:hover {
            color: var(--dark-main);
        }

        .nav-cta-pill {
            background-color: var(--dark-main);
            color: var(--card-white);
            padding: 8px 22px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* 2. Hero Superior 1 (Título y Foto Real) */
        .hero-top-section {
            padding: 50px 45px;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 40px;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .hero-top-section h1 {
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 15px;
            color: var(--dark-main);
        }

        .hero-top-section p {
            font-size: 0.98rem;
            color: var(--gray-text);
            margin-bottom: 25px;
        }

        .btn-dark-action {
            display: inline-block;
            background-color: var(--dark-main);
            color: var(--card-white);
            padding: 12px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .hero-photo-container {
            width: 100%;
            height: 280px;
            border-radius: var(--radius-inner);
            overflow: hidden;
            background-color: var(--light-bg);
        }

        .hero-photo-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

        /* 3. Hero Central 2 (Banner Oscuro Curvo con Frase) */
        .curved-banner-padding {
            padding: 40px 45px;
        }

        .curved-dark-card-box {
            background: var(--dark-main);
            border-radius: var(--radius-outer);
            padding: 50px;
            color: var(--card-white);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .curved-dark-card-box h2 {
            font-size: 2.3rem;
            font-weight: 600;
            max-width: 550px;
            line-height: 1.2;
        }

        .btn-light-action {
            background: var(--card-white);
            color: var(--dark-main);
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        /* 4. Mini Fila de Credenciales / Perfiles */
        .credentials-row-grid {
            padding: 0 45px 40px 45px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .cred-card-box {
            background: var(--light-bg);
            padding: 20px;
            border-radius: var(--radius-inner);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .cred-avatar-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--border-color);
            overflow: hidden;
            flex-shrink: 0;
        }

        .cred-avatar-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cred-info h4 {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .cred-info p {
            font-size: 0.78rem;
            color: var(--gray-text);
        }

        /* 5. Secciones de Contenido */
        .section-container-box {
            padding: 40px 45px 60px 45px;
            border-top: 1px solid var(--border-color);
        }

        .section-title-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
        }

        .section-title-wrapper h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--dark-main);
        }

        .section-title-wrapper p {
            color: var(--gray-text);
            font-size: 0.9rem;
        }

        /* Grid de Proyectos */
        .projects-two-column-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .project-item-card {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .project-tag-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .tag-pill-badge {
            background: var(--card-white);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .project-item-card h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--dark-main);
        }

        .project-item-card p {
            color: var(--gray-text);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        /* Herramientas Grid */
        .tools-pills-flex {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .tool-pill-badge {
            background: var(--light-bg);
            padding: 10px 20px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 0.9rem;
            border: 1px solid rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Educación Grid */
        .education-three-column-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .edu-item-card {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 25px;
        }

        .edu-tag-badge {
            display: inline-block;
            background: var(--card-white);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 10px;
            color: var(--dark-main);
        }

        .edu-item-card h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark-main);
            margin-bottom: 6px;
        }

        .edu-item-card p {
            font-size: 0.82rem;
            color: var(--gray-text);
        }

        /* 6. Footer Oscuro Inferior */
        footer {
            background-color: var(--dark-main);
            color: var(--card-white);
            padding: 50px 45px 30px 45px;
            border-top-left-radius: 28px;
            border-top-right-radius: 28px;
        }

        .footer-grid-layout {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col-content h4 {
            font-size: 1rem;
            margin-bottom: 12px;
            color: var(--card-white);
        }

        .footer-col-content p {
            color: #A8A29E;
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .footer-links-list {
            list-style: none;
        }

        .footer-links-list li {
            margin-bottom: 8px;
        }

        .footer-links-list a {
            color: #A8A29E;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .footer-social-icons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .footer-social-icons a {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,0.08);
            color: var(--card-white);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .footer-bottom-bar {
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #78716C;
            font-size: 0.8rem;
        }

        @media (max-width: 768px) {
            .hero-top-section, .projects-two-column-grid, .education-three-column-grid, .footer-grid-layout, .credentials-row-grid {
                grid-template-columns: 1fr;
            }
            .curved-dark-card-box {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            .nav-links-center {
                display: none;
            }
        }
    </style>
</head>
