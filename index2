<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen Holguín | Senior IT Project Manager</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-canvas: #EAE6DF;
            --container-bg: #FFFFFF;
            --dark-main: #1C1917;
            --gray-text: #78716C;
            --light-bg: #F5F5F4;
            --border-color: #E7E5E4;
            --radius-outer: 32px;
            --radius-inner: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--dark-main);
            padding: 20px;
            line-height: 1.5;
        }

        .main-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--container-bg);
            border-radius: var(--radius-outer);
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.03);
        }

        /* 1. Header / Navbar Superior */
        .top-nav-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px;
            border-bottom: 1px solid var(--border-color);
        }

        .nav-logo-tag {
            background: var(--light-bg);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-menu-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-menu-links a {
            text-decoration: none;
            color: var(--gray-text);
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .nav-menu-links a:hover {
            color: var(--dark-main);
        }

        .nav-contact-btn {
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 8px 22px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* 2. Hero Section 1 (Bloque Superior con Foto) */
        .hero-section-one {
            padding: 50px 40px;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 40px;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .hero-section-one h1 {
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 15px;
            color: var(--dark-main);
        }

        .hero-section-one p {
            font-size: 0.98rem;
            color: var(--gray-text);
            margin-bottom: 25px;
        }

        .btn-main-action {
            display: inline-block;
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 12px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .hero-photo-box {
            width: 100%;
            height: 280px;
            border-radius: var(--radius-inner);
            overflow: hidden;
            background-color: var(--light-bg);
        }

        .hero-photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

        /* 3. Hero Section 2 (Banner Curvo Oscuro Central Estilo Referencia) */
        .curved-banner-container {
            padding: 40px;
        }

        .curved-dark-hero-card {
            background: var(--dark-main);
            border-radius: var(--radius-outer);
            padding: 50px;
            color: var(--container-bg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .curved-dark-hero-card h2 {
            font-size: 2.2rem;
            font-weight: 600;
            max-width: 550px;
            line-height: 1.2;
        }

        .btn-light-action {
            background: var(--container-bg);
            color: var(--dark-main);
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        /* 4. Mini Barra de Perfiles / Credenciales (Estilo Tarjetas Horizontales de Referencia) */
        .credentials-row {
            padding: 0 40px 40px 40px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .credential-card-item {
            background: var(--light-bg);
            padding: 20px;
            border-radius: var(--radius-inner);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .credential-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--border-color);
            overflow: hidden;
            flex-shrink: 0;
        }

        .credential-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .credential-text h4 {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .credential-text p {
            font-size: 0.78rem;
            color: var(--gray-text);
        }

        /* 5. Secciones Generales del Portafolio */
        .content-section-box {
            padding: 40px 40px 60px 40px;
            border-top: 1px solid var(--border-color);
        }

        .section-header-flex {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
        }

        .section-header-flex h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--dark-main);
        }

        .section-header-flex p {
            color: var(--gray-text);
            font-size: 0.9rem;
        }

        /* Grid de Proyectos Estilo Imagen */
        .projects-grid-layout {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .project-card-item {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .project-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .project-tag-pill {
            background: var(--container-bg);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--dark-main);
        }

        .project-card-item h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--dark-main);
        }

        .project-card-item p {
            color: var(--gray-text);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        /* Herramientas Grid */
        .tools-flex-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .tool-pill-item {
            background: var(--light-bg);
            padding: 10px 20px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 0.9rem;
            border: 1px solid rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Educación Grid */
        .education-grid-layout {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .education-card-item {
            background: var(--light-bg);
            border-radius: var(--radius-inner);
            padding: 25px;
        }

        .education-tag-pill {
            display: inline-block;
            background: var(--container-bg);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 10px;
            color: var(--dark-main);
        }

        .education-card-item h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark-main);
            margin-bottom: 6px;
        }

        .education-card-item p {
            font-size: 0.82rem;
            color: var(--gray-text);
        }

        /* 6. Footer Oscuro Estilo Inferior de la Imagen */
        footer {
            background-color: var(--dark-main);
            color: var(--container-bg);
            padding: 50px 40px 30px 40px;
            border-top-left-radius: 28px;
            border-top-right-radius: 28px;
        }

        .footer-grid-layout {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-column h4 {
            font-size: 1rem;
            margin-bottom: 12px;
            color: var(--container-bg);
        }

        .footer-column p {
            color: #A8A29E;
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .footer-links-list {
            list-style: none;
        }

        .footer-links-list li {
            margin-bottom: 8px;
        }

        .footer-links-list a {
            color: #A8A29E;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .footer-social-row {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .footer-social-row a {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,0.08);
            color: var(--container-bg);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .footer-bottom-bar {
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #78716C;
            font-size: 0.8rem;
        }

        @media (max-width: 768px) {
            .hero-section-one, .projects-grid-layout, .education-grid-layout, .footer-grid-layout, .credentials-row {
                grid-template-columns: 1fr;
            }
            .curved-dark-hero-card {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            .nav-menu-links {
                display: none;
            }
        }
    </style>
</head>
