<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen Holguín | Senior IT Project Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-body: #EFECE6;
            --card-bg: #FFFFFF;
            --dark-primary: #1C1917;
            --accent-taupe: #78716C;
            --light-taupe: #E7E5E4;
            --tag-bg: #F5F5F4;
            --border-radius: 28px;
            --card-radius: 20px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-body);
            color: var(--dark-primary);
            line-height: 1.5;
            padding: 20px;
        }

        .page-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: 0 20px 40px rgba(0,0,0,0.04);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.03);
        }

        /* Top Bar / Nav estilo la imagen */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 40px;
            border-bottom: 1px solid var(--light-taupe);
        }

        .logo-pill {
            background: var(--tag-bg);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sub-nav {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .sub-nav a {
            text-decoration: none;
            color: var(--accent-taupe);
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .sub-nav a:hover {
            color: var(--dark-primary);
        }

        .btn-top-cta {
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 8px 20px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* Hero Superior Exacto a la Referencia */
        .hero-section-top {
            padding: 50px 40px;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 40px;
            align-items: center;
            border-bottom: 1px solid var(--light-taupe);
        }

        .hero-section-top h1 {
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 15px;
            color: var(--dark-primary);
        }

        .hero-section-top p {
            font-size: 0.98rem;
            color: var(--accent-taupe);
            margin-bottom: 25px;
        }

        .btn-dark-pill {
            display: inline-block;
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 12px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: transform 0.2s;
        }

        .btn-dark-pill:hover {
            transform: translateY(-2px);
        }

        .hero-img-top {
            width: 100%;
            height: 260px;
            border-radius: var(--card-radius);
            overflow: hidden;
            background-color: var(--light-taupe);
        }

        .hero-img-top img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

        /* Banner Curvo Oscuro Central (Segundo bloque de la imagen) */
        .curved-banner-box {
            padding: 40px;
        }

        .curved-dark-card {
            background: var(--dark-primary);
            border-radius: var(--border-radius);
            padding: 50px;
            color: var(--card-bg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .curved-dark-card h2 {
            font-size: 2.2rem;
            font-weight: 600;
            max-width: 550px;
            line-height: 1.2;
        }

        .curved-dark-card .btn-light-pill {
            background: var(--card-bg);
            color: var(--dark-primary);
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        /* Mini sección de equipo / pilares estilo referencia */
        .mini-features {
            padding: 0 40px 40px 40px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .mini-feature-item {
            background: var(--tag-bg);
            padding: 20px;
            border-radius: var(--card-radius);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .mini-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--light-taupe);
            overflow: hidden;
            flex-shrink: 0;
        }

        .mini-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .mini-feature-text h4 {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--dark-primary);
        }

        .mini-feature-text p {
            font-size: 0.78rem;
            color: var(--accent-taupe);
        }

        /* Secciones de Contenido (Proyectos, Herramientas, etc.) */
        .section-box {
            padding: 40px 40px 60px 40px;
            border-top: 1px solid var(--light-taupe);
        }

        .section-title-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
        }

        .section-title-row h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--dark-primary);
        }

        .section-title-row p {
            color: var(--accent-taupe);
            font-size: 0.9rem;
        }

        /* Grid de Proyectos estilo tarjetas de la referencia */
        .projects-grid-ref {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .project-card-ref {
            background: var(--tag-bg);
            border-radius: var(--card-radius);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .project-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .project-tag-small {
            background: var(--card-bg);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--dark-primary);
        }

        .project-card-ref h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--dark-primary);
        }

        .project-card-ref p {
            color: var(--accent-taupe);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        /* Herramientas Grid */
        .tools-flex {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .tool-tag-ref {
            background: var(--tag-bg);
            padding: 10px 20px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 0.9rem;
            border: 1px solid rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Educación Grid */
        .edu-grid-ref {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .edu-card-ref {
            background: var(--tag-bg);
            border-radius: var(--card-radius);
            padding: 25px;
        }

        .edu-tag-ref {
            display: inline-block;
            background: var(--card-bg);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 10px;
            color: var(--dark-primary);
        }

        .edu-card-ref h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark-primary);
            margin-bottom: 6px;
        }

        .edu-card-ref p {
            font-size: 0.82rem;
            color: var(--accent-taupe);
        }

        /* Footer Oscuro Estilo la Imagen */
        footer {
            background-color: var(--dark-primary);
            color: var(--card-bg);
            padding: 50px 40px 30px 40px;
            border-top-left-radius: 28px;
            border-top-right-radius: 28px;
        }

        .footer-grid-ref {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col-ref h4 {
            font-size: 1rem;
            margin-bottom: 12px;
            color: var(--card-bg);
        }

        .footer-col-ref p {
            color: #A8A29E;
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .footer-links-ref {
            list-style: none;
        }

        .footer-links-ref li {
            margin-bottom: 8px;
        }

        .footer-links-ref a {
            color: #A8A29E;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .footer-social-icons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .footer-social-icons a {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,0.08);
            color: var(--card-bg);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .footer-bottom-ref {
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #78716C;
            font-size: 0.8rem;
        }

        @media (max-width: 768px) {
            .hero-section-top, .projects-grid-ref, .edu-grid-ref, .footer-grid-ref, .mini-features {
                grid-template-columns: 1fr;
            }
            .curved-dark-card {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            .sub-nav {
                display: none;
            }
        }
    </style>
</head>
